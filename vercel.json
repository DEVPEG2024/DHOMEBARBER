{
  "rewrites": [
    { "source": "/lm/:id/carte.jpg", "destination": "https://dhomebarber-api-3aabb8313cb6.herokuapp.com/api/share/last-minute/:id/carte.jpg" },
    { "source": "/lm/:id", "destination": "https://dhomebarber-api-3aabb8313cb6.herokuapp.com/api/share/last-minute/:id" },
    { "source": "/agenda/rdv/:id/:sig", "destination": "https://dhomebarber-api-3aabb8313cb6.herokuapp.com/api/calendar/rdv/:id/:sig" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
